+  /**
+   * Asistente: apertura y forma de boca según la vocal (no solo el volumen).
+   * Espectro de los últimos ~25 ms en tres bandas: graves (200-650 Hz),
+   * medios (650-2200 Hz) y agudos (2200-5000 Hz). Calibrado con la voz RVC:
+   * A = casi todo en medios (boca muy abierta); E/I = agudos fuertes (boca
+   * estirada, I casi cerrada); O/U = sin agudos (boca redonda, U más cerrada).
+   */
+  private updateVowel(deltaTimeSeconds: number): void {
+    const N = 1024;
+    const fs = this._wavFileInfo._samplingRate;
+    const pcm = this._pcmData[0];
+    let open = 0.0;
+    let form = 0.0;
+    if (this._sampleOffset >= N) {
+      if (!this._fftRe) {
+        this._fftRe = new Float32Array(N);
+        this._fftIm = new Float32Array(N);
+        this._fftWin = new Float32Array(N);
+        for (let i = 0; i < N; i++) {
+          this._fftWin[i] = 0.5 - 0.5 * Math.cos((2 * Math.PI * i) / (N - 1));
+        }
+      }
+      const re = this._fftRe;
+      const im = this._fftIm;
+      const start = this._sampleOffset - N;
+      let rms = 0.0;
+      for (let i = 0; i < N; i++) {
+        const v = pcm[start + i];
+        re[i] = v * this._fftWin[i];
+        im[i] = 0.0;
+        if (i >= N / 3) rms += v * v;
+      }
+      rms = Math.sqrt(rms / (N - Math.ceil(N / 3)));
+      fft(re, im);
+      const binHz = fs / N;
+      const band = (a: number, b: number): number => {
+        let e = 1e-12;
+        const hi = Math.min(N / 2, Math.ceil(b / binHz));
+        for (let k = Math.floor(a / binHz); k < hi; k++) {
+          e += re[k] * re[k] + im[k] * im[k];
+        }
+        return e;
+      };
+      const L = band(200, 650);
+      const M = band(650, 2200);
+      const H = band(2200, 5000);
+      const medios = M / (L + M + H);
+      const agudosDb = 10 * Math.log10(H / (L + M));
+      const clamp = (v: number): number => Math.min(1, Math.max(0, v));
+
+      const volumen = Math.pow(clamp((rms - 0.02) / 0.2), 0.7);
+      const estirada = clamp((agudosDb + 28) / 12) * clamp((0.85 - medios) / 0.3);
+      // umbral algo permisivo: en frases seguidas la O/U arrastra agudos de las consonantes
+      const redonda =
+        (1 - clamp((agudosDb + 23) / 8)) * clamp((0.8 - medios) / 0.35);
+      open = volumen * (0.3 + 0.7 * clamp(medios / 0.85));
+      form = volumen > 0 ? estirada - redonda : 0.0;
+    }
+    // suavizado: abre rápido, cierra un poco más lento (independiente de los fps)
+    const tau = open > this._mouthOpen ? 0.025 : 0.06;
+    this._mouthOpen += (open - this._mouthOpen) * (1 - Math.exp(-deltaTimeSeconds / tau));
+    // la forma se marca rápido y se suelta algo más lento, para que la O/U alcance a verse
+    const tauForma = Math.abs(form) > Math.abs(this._mouthForm) ? 0.05 : 0.09;
+    this._mouthForm += (form - this._mouthForm) * (1 - Math.exp(-deltaTimeSeconds / tauForma));
+  }
